# Copier ce fichier en ".env" (à cette même racine, à côté de
# docker-compose.yml) et remplir de vraies valeurs. Ce .env-ci est
# DIFFÉRENT de celui déjà présent dans backend/ — celui-là reste pour un
# lancement sans Docker, jamais lu par docker-compose.

POSTGRES_USER=gestion_academique_user
POSTGRES_PASSWORD=
POSTGRES_DB=gestion_academique

JWT_SECRET=

# Même valeur que CLE_API_INTEGRATION déjà utilisée par le backend
# académique sans Docker — le financier doit continuer à présenter
# exactement la même clé pour être reconnu.
CLE_API_INTEGRATION=
