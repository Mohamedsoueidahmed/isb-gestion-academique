# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne jamais commiter le fichier ".env" dans un dépôt Git.

# Connexion à la base de données PostgreSQL
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/gestion_academique?schema=public"

# Secret utilisé pour signer les tokens JWT — générer une chaîne longue et aléatoire
JWT_SECRET="a_remplacer_par_une_valeur_secrete_longue_et_aleatoire"

# Port d'écoute du serveur backend
PORT=3000

# Environnement d'exécution
NODE_ENV="development"
